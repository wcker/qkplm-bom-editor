{
  "name": "@bom-editor/benchmark-fixtures",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic BOM benchmark fixture definitions and generators.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "pnpm --filter @bom-editor/contracts build",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @bom-editor/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@bom-editor/contracts": "workspace:*"
  }
}
