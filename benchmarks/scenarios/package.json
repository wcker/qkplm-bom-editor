{
  "name": "@bom-editor/benchmark-scenarios",
  "version": "0.0.0",
  "private": true,
  "description": "Executable prechecks for versioned BOM editor benchmark scenarios.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "benchmark:f3:headless": "node test/f3-headless.test.mjs",
    "benchmark:f4:headless": "node --expose-gc scripts/f4-headless-baseline.mjs",
    "benchmark:f3:browser:smoke": "node scripts/f3-browser-evidence.mjs --mode=smoke --headless",
    "benchmark:f3:browser:formal": "node scripts/f3-browser-evidence.mjs --mode=formal --headed"
  },
  "dependencies": {
    "@bom-editor/benchmark-fixtures": "workspace:*",
    "@qkplm/bom-editor": "workspace:*",
    "@bom-editor/model": "workspace:*",
    "@bom-editor/visible-projection": "workspace:*"
  }
}
