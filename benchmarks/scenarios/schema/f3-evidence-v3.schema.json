{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "f3-evidence-v3.schema.json",
  "title": "BOM editor F3 browser evidence candidate v3",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "mode",
    "overall",
    "f3Pass",
    "qualification",
    "evidence",
    "evidenceIntegrity",
    "trace"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bom-f3-browser-evidence/v3"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": ["smoke", "formal"]
    },
    "overall": {
      "enum": ["unqualified", "failed"]
    },
    "f3Pass": {
      "const": false
    },
    "qualification": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "releaseQualified",
        "certifiedTraceExtractor",
        "destroyRetentionQualified",
        "applicationPixelEvidenceQualified",
        "blockers"
      ],
      "properties": {
        "releaseQualified": { "const": false },
        "certifiedTraceExtractor": { "type": "boolean" },
        "destroyRetentionQualified": { "type": "boolean" },
        "applicationPixelEvidenceQualified": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realmMemoryArtifact",
        "applicationPixelEvidenceArtifact",
        "applicationPixelCorrelationArtifact"
      ],
      "properties": {
        "realmMemoryArtifact": {
          "type": ["string", "null"]
        },
        "applicationPixelEvidenceArtifact": {
          "type": ["string", "null"]
        },
        "applicationPixelCorrelationArtifact": {
          "type": ["string", "null"]
        }
      }
    },
    "evidenceIntegrity": {
      "$ref": "#/$defs/evidenceIntegrity"
    },
    "sampling": {
      "type": "object",
      "required": ["warmup", "measured"],
      "properties": {
        "warmup": { "type": "integer", "minimum": 1 },
        "measured": { "type": "integer", "minimum": 3 }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "coldInteractiveReadyCandidate",
        "inputFeedbackCandidate",
        "continuousScrollPresentation"
      ],
      "properties": {
        "coldInteractiveReadyCandidate": {
          "$ref": "f3-evidence.schema.json#/$defs/metric"
        },
        "inputFeedbackCandidate": {
          "$ref": "f3-evidence.schema.json#/$defs/inputMetric"
        },
        "continuousScrollPresentation": {
          "anyOf": [
            { "$ref": "#/$defs/scrollMetric" },
            { "type": "null" }
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "lifecycle",
        "performance",
        "memory",
        "realmMemory",
        "memorySupported",
        "memoryWithinLimit"
      ],
      "properties": {
        "lifecycle": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "f3-evidence.schema.json#/$defs/lifecycleMemoryEntry"
          }
        },
        "performance": {
          "type": "object",
          "required": [
            "coldInteractiveReadyCandidate",
            "inputFeedbackRenderCommitCandidate",
            "continuousScrollPresentation"
          ],
          "properties": {
            "continuousScrollPresentation": {
              "$ref": "f3-evidence-v2.schema.json#/$defs/scrollGate"
            }
          }
        },
        "memory": {
          "$ref": "f3-evidence.schema.json#/$defs/memoryQualification"
        },
        "realmMemory": {
          "$ref": "disposable-realm-memory-evidence-v1.schema.json#/$defs/qualification"
        },
        "memorySupported": { "type": "boolean" },
        "memoryWithinLimit": { "type": "null" }
      }
    },
    "trace": {
      "$ref": "f3-evidence-v2.schema.json#/$defs/trace"
    },
    "error": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": { "error": {} },
          "required": ["error"]
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "sampling": {},
          "metrics": {},
          "gates": {},
          "evidence": {
            "type": "object",
            "properties": {
              "realmMemoryArtifact": {
                "const": "raw/disposable-realm-memory.json"
              },
              "applicationPixelEvidenceArtifact": {
                "const": "raw/continuous-scroll.json"
              }
            },
            "required": [
              "realmMemoryArtifact",
              "applicationPixelEvidenceArtifact",
              "applicationPixelCorrelationArtifact"
            ]
          }
        },
        "required": ["sampling", "metrics", "gates"]
      }
    },
    {
      "if": {
        "properties": {
          "gates": {
            "type": "object",
            "properties": {
              "realmMemory": {
                "type": "object",
                "properties": { "qualified": { "const": true } },
                "required": ["qualified"]
              }
            },
            "required": ["realmMemory"]
          }
        },
        "required": ["gates"]
      },
      "then": {
        "properties": {
          "qualification": {
            "type": "object",
            "properties": {
              "destroyRetentionQualified": { "const": true }
            }
          }
        }
      },
      "else": {
        "properties": {
          "qualification": {
            "type": "object",
            "properties": {
              "destroyRetentionQualified": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trace": {
            "type": "object",
            "properties": {
              "extraction": {
                "type": "object",
                "properties": { "status": { "const": "succeeded" } },
                "required": ["status"]
              }
            },
            "required": ["extraction"]
          }
        },
        "required": ["trace"]
      },
      "then": {
        "properties": {
          "qualification": {
            "type": "object",
            "properties": {
              "certifiedTraceExtractor": { "const": true }
            }
          },
          "trace": {
            "type": "object",
            "properties": {
              "certifiedExtractor": { "const": true }
            }
          }
        }
      },
      "else": {
        "properties": {
          "qualification": {
            "type": "object",
            "properties": {
              "certifiedTraceExtractor": { "const": false }
            }
          },
          "trace": {
            "type": "object",
            "properties": {
              "certifiedExtractor": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "checkedAt",
        "status",
        "verified",
        "build",
        "evidenceTooling",
        "blockers",
        "error"
      ],
      "properties": {
        "protocol": { "const": "bom-f3-evidence-integrity/v1" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["verified", "mutated", "unavailable"] },
        "verified": { "type": "boolean" },
        "build": { "$ref": "#/$defs/evidenceIntegrityManifest" },
        "evidenceTooling": { "$ref": "#/$defs/evidenceIntegrityManifest" },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "error": { "type": ["object", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": {
            "properties": {
              "verified": { "const": true },
              "blockers": { "maxItems": 0 },
              "error": { "const": null }
            }
          },
          "else": { "properties": { "verified": { "const": false } } }
        }
      ]
    },
    "evidenceIntegrityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialAggregateSha256",
        "finalAggregateSha256",
        "stable"
      ],
      "properties": {
        "initialAggregateSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "finalAggregateSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "stable": { "type": ["boolean", "null"] }
      }
    },
    "scrollMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "authoritativeSource",
        "windowDurationMs",
        "presentedFrameCount",
        "statistics",
        "missedVsyncCount",
        "compositorMissingOrCheckerboardFrameCount",
        "applicationPixelCorrelationQualified",
        "applicationPixelBlankFrameCount"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "authoritativeSource": {
          "const": "Display::FrameDisplayed"
        },
        "windowDurationMs": {
          "type": "number",
          "minimum": 30000
        },
        "presentedFrameCount": {
          "type": "integer",
          "minimum": 2
        },
        "statistics": {
          "$ref": "f3-evidence.schema.json#/$defs/metric/properties/statistics"
        },
        "missedVsyncCount": {
          "type": "integer",
          "minimum": 0
        },
        "compositorMissingOrCheckerboardFrameCount": {
          "type": "integer",
          "minimum": 0
        },
        "applicationPixelCorrelationQualified": {
          "type": "boolean"
        },
        "applicationPixelBlankFrameCount": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}
