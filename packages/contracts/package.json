{
  "name": "@bom-editor/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "DOM-free, serializable public contracts for the BOM editor SDK.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node scripts/check-boundary.mjs && tsc -p tsconfig.typecheck.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
