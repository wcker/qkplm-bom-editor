{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@bom-editor/contracts": [
        "../contracts/dist/index.d.ts"
      ],
      "@bom-editor/datasource": [
        "../datasource/dist/index.d.ts"
      ],
      "@bom-editor/editor": [
        "../editor/dist/index.d.ts"
      ],
      "@bom-editor/model": [
        "../model/dist/index.d.ts"
      ],
      "@bom-editor/renderer-canvas": [
        "../renderer-canvas/dist/index.d.ts"
      ],
      "@bom-editor/runtime": [
        "../runtime/dist/index.d.ts"
      ],
      "@bom-editor/transaction": [
        "../transaction/dist/index.d.ts"
      ],
      "@bom-editor/worker": [
        "../worker/dist/index.d.ts"
      ]
    },
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
