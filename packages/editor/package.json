{
  "name": "@bom-editor/editor",
  "version": "0.0.0",
  "private": true,
  "description": "F3 browser editor orchestration for the BOM editor.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "pnpm --filter @bom-editor/renderer-canvas build && pnpm --filter @bom-editor/datasource build && pnpm --filter @bom-editor/transaction build",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "pnpm run prebuild && tsc -p tsconfig.typecheck.json",
    "test": "pnpm run build && node --test --test-isolation=none test/editor.test.mjs"
  },
  "dependencies": {
    "@bom-editor/contracts": "workspace:*",
    "@bom-editor/datasource": "workspace:*",
    "@bom-editor/model": "workspace:*",
    "@bom-editor/renderer-canvas": "workspace:*",
    "@bom-editor/runtime": "workspace:*",
    "@bom-editor/transaction": "workspace:*",
    "@bom-editor/visible-projection": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
