{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@bom-editor/contracts": [
        "../contracts/dist/index.d.ts"
      ],
      "@bom-editor/datasource": [
        "../datasource/dist/index.d.ts"
      ],
      "@bom-editor/model": [
        "../model/dist/index.d.ts"
      ],
      "@bom-editor/renderer-canvas": [
        "../renderer-canvas/dist/index.d.ts"
      ],
      "@bom-editor/runtime": [
        "../runtime/dist/index.d.ts"
