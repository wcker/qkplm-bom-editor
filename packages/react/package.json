{
  "name": "@qkplm/bom-editor-react",
  "version": "1.0.0-rc.1",
  "description": "React lifecycle bridge for the QKPLM BOM editor.",
  "license": "Apache-2.0",
  "author": "QKPLM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcker/qkplm-bom-editor.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/wcker/qkplm-bom-editor",
  "bugs": {
    "url": "https://github.com/wcker/qkplm-bom-editor/issues"
  },
  "keywords": ["bom", "editor", "react", "qkplm"],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "node ../../scripts/sync-package-legal-files.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@qkplm/bom-editor": "workspace:1.0.0-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
