{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@bom-editor/contracts": [
        "../contracts/dist/index.d.ts"
      ],
      "@bom-editor/model": [
        "../model/dist/index.d.ts"
      ],
      "@bom-editor/runtime": [
        "../runtime/dist/index.d.ts"
      ],
      "@bom-editor/visible-projection": [
        "../visible-projection/dist/index.d.ts"
      ]
    },
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts"
  ]
}
