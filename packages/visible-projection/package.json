{
  "name": "@bom-editor/visible-projection",
  "version": "0.0.0",
  "private": true,
  "description": "DOM-free incremental visible preorder and row-position index for BOM snapshots.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @bom-editor/model build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @bom-editor/model build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/visible-projection.test.mjs"
  },
  "dependencies": {
    "@bom-editor/contracts": "workspace:*",
    "@bom-editor/model": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
